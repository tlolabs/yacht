{
  "table_class": "table table-bordered table-hover table-condensed",
  "font_family": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
  "font_size_px": 14,
  "cell_padding_px": 8,
  "border_width_px": 1,
  "border_style": "solid",
  "border_color": "#cccccc",
  "header_bg": "#f5f5f5",
  "header_text_color": "#222222",
  "body_bg": "#ffffff",
  "zebra_enabled": true,
  "zebra_bg": "#fbfbfb",
  "hover_enabled": true,
  "hover_bg": "#f2f8ff",
  "border_collapse": "collapse",
  "border_spacing_px": 0
}
