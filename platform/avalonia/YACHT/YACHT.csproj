<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../windows/Version.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">../../windows/app.manifest</ApplicationManifest>
    <ApplicationIcon>../../../assets/icons/YACHT.ico</ApplicationIcon>
    <AssemblyName>YachtApp</AssemblyName><Product>YACHT</Product>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- BuildServices is telemetry-only; exclude its build tasks for this project. -->
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
  </ItemGroup>
  <ItemGroup><Content Include="../../../assets/icons/YACHT.ico" Link="YACHT.ico" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="NativeIntegration" /></ItemGroup>
  <Target Name="RejectUnsupportedMac" BeforeTargets="Publish" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-')) and '$(RuntimeIdentifier)' != 'osx-arm64'">
    <Error Text="Only the internal macOS ARM64 reference target is supported." />
  </Target>
</Project>
